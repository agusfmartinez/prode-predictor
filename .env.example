# Copia este archivo como .env y completa tus valores reales.
# El .env real NUNCA se sube al repo (ver .gitignore).
#
# Ya no hace falta ninguna API key de datos de futbol: los datos
# salen del endpoint publico de Promiedos (ver promiedos_client.py).
# Lo unico que necesitas configurar es Telegram (opcional).

TELEGRAM_BOT_TOKEN=tu_token_de_botfather
TELEGRAM_CHAT_ID=tu_chat_id
